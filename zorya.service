[Unit]
Description=Zorya Usina Computacional Node (Tailscale OpenAI Daemon)
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
User=%I
WorkingDirectory=/opt/zorya
ExecStart=/opt/zorya/target/release/zorya
Restart=always
RestartSec=5s
Environment=RUST_LOG=info

# Hardening basico
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
